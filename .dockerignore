# =============================================================================
# Files and directories to exclude from Docker build context
# =============================================================================

# Version control
.git
.gitignore
.gitattributes

# Environment files (NEVER ship)
.env
.env.*
!.env.example
!*.docker

# Local development
node_modules
vendor
.npm
.yarn

# IDE & editor
.idea
.vscode
*.sublime-*
.DS_Store
Thumbs.db

# Build artifacts
/public/build
/public/hot
/public/storage

# Cache & logs
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!storage/logs/.gitkeep
/storage/debugbar

# Docker (prevent recursive build context)
docker/mysql/data
docker/redis/data
docker/nginx/logs
docker/nginx/ssl/*.pem
docker/nginx/ssl/*.key
docker/nginx/ssl/*.crt
docker-compose.override.yml
docker-compose.yml
Dockerfile

# Backups & temp files
*.bak
*.backup
*.old
*.orig
*.tmp
*.swp
*.swo
*~
*.sql
*.tar.gz

# Testing
tests/
phpunit.xml
.phpunit.cache

# Documentation (already in repo, not needed at runtime)
README.md
INSTALLATION.md

# Scripts
scripts/
deploy-security.sh
deploy-security.bat
