# ================================
# Docker
# ================================
# Docker override for local development
docker-compose.override.yml

# Docker volumes and data directories
.docker/
docker/mysql/data/
docker/redis/data/

# Docker runtime files
.initialized

# Docker logs (stored in storage/logs instead)
docker/nginx/logs/
docker/mysql/logs/

# SSL certificates (add your own, don't commit)
docker/nginx/ssl/*.pem
docker/nginx/ssl/*.key
docker/nginx/ssl/*.crt
!docker/nginx/ssl/.gitkeep

# Docker backup files
docker-backup-*.tar.gz

